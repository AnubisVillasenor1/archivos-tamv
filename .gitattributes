# Normalización de texto: LF en el repositorio, conversión nativa al hacer checkout.
* text=auto eol=lf

# Fuentes y documentos
*.ts text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Scripts de shell siempre LF
*.sh text eol=lf
*.mjs text eol=lf

# Binarios: no normalizar
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary